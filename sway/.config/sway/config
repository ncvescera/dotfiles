    colors {
        statusline #ffffff
        background #323232
        # inactive_workspace #32323201 #32323200 #5c5c5c
        # focused_workspace #32323200 #32323200 #000000
        focused_workspace #ffffff #ffffff #5c5c5c
    }
    font pango:DejaVu Sans Mono, FontAwesome 10
}

