general {
        output_format = "i3bar"
        colors = true
        interval = 5
}

order += "path_exists VPN"
order += "disk /"
order += "ethernet enp42s0"
order += "ipv6"
# order += "cpu_temperature 0" # TODO: controllare se fixabile
order += "memory"
order += "load"
order += "tztime local"
# order += "run_watch DHCP"
# order += "run_watch VPNC"

ipv6 {
        format_up = "💻 %ip"
        format_down = "💻 ❌(v6)"
}

ethernet enp42s0 {
        format_up = "💻 %ip (%speed)"
        format_down = "💻 ❌"
}


run_watch DHCP {
        pidfile = "/var/run/dhclient*.pid"
}

run_watch VPNC {
        # file containing the PID of a vpnc process
        pidfile = "/var/run/vpnc/pid"
}

path_exists VPN {
        # path exists when a VPN tunnel launched by nmcli/nm-applet is active
        path = "/proc/sys/net/ipv4/conf/ppp0"
        format = "🔐"
        format_down = "🔓"
}

tztime local {
        format = "🕑 %H:%M:%S %d-%m-%Y"
        timezone = "Europe/Rome"
}

load {
        format = "⚡️%1min %5min %15min"
        max_threshold = "6.0"
        format_above_threshold = "⚡️⚠️ %1min %5min %15min"
}

cpu_temperature 0 {
        format = "🔥 %degrees °C"
        path = "/sys/devices/platform/coretemp.0/temp1_input"
}

memory {
        format = "📊 %used"
        threshold_degraded = "10%"
        format_degraded = "MEMORY: %free"
}

disk "/" {
        format = "💾 %free"
}

read_file uptime {
        path = "/proc/uptime"
}
